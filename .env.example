# คัดลอกไฟล์นี้เป็น `.env` (ที่ root ของ repo) แล้วแก้ค่าให้ตรงกับเครื่อง — ห้าม commit ไฟล์ .env

# --- Django ---
# 1 = โหมด dev (เปิด debug และมี SECRET_KEY สำรองให้) / production ต้องเป็น 0 และตั้ง DJANGO_SECRET_KEY เอง
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (ใช้ทั้ง docker-compose.yml และ Django) ---
POSTGRES_DB=mangosteen
POSTGRES_USER=mangosteen
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
