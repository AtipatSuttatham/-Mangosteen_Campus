# คัดลอกไฟล์นี้เป็น `.env` (ที่ root ของ repo) แล้วแก้ค่าให้ตรงกับเครื่อง — ห้าม commit ไฟล์ .env

# --- Django ---
# 1 = โหมด dev (เปิด debug และมี SECRET_KEY สำรองให้) / production ต้องเป็น 0 และตั้ง DJANGO_SECRET_KEY เอง
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- อีเมล ---
# ที่อยู่เว็บ (frontend) ที่ใช้ทำลิงก์ในอีเมลยืนยัน/ตั้งรหัสผ่าน — ตอน dev ไม่ต้องตั้ง (ใช้ http://localhost:5180)
# ขึ้นเว็บจริงต้องตั้งเป็นโดเมนจริง ไม่ตั้ง = แอปไม่ยอมเริ่ม
FRONTEND_URL=
# ตอน dev อีเมลจะพิมพ์ลงคอนโซลของ backend (ไม่ส่งจริง) — ขึ้นเว็บจริงค่อยตั้ง DJANGO_EMAIL_BACKEND / EMAIL_* ตาม provider ที่เลือก

# --- PostgreSQL (ใช้ทั้ง docker-compose.yml และ Django) ---
POSTGRES_DB=mangosteen
POSTGRES_USER=mangosteen
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
# พอร์ตของ Postgres บนเครื่อง — ถ้าเครื่องมี PostgreSQL ตัวอื่นใช้ 5432 อยู่แล้ว (จะต่อผิดตัวและล็อกอินไม่ผ่าน) ให้เปลี่ยนเป็น 5433
POSTGRES_PORT=5432

# --- บัญชีทดสอบ (เฉพาะเครื่อง dev) ---
# รหัสผ่านของบัญชีที่ `manage.py seed_demo` สร้าง (ทุกบทบาทใช้รหัสเดียวกัน) — เลือกเอง ยาวอย่างน้อย 12 ตัวอักษร
# ห้ามใส่รหัสจริงในไฟล์นี้ (ไฟล์นี้เข้า git และ repo เป็น public) ให้ใส่ใน .env ของตัวเองเท่านั้น
DEMO_PASSWORD=
